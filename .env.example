# Copy to .env next to docker-compose.yml. Compose refuses to start when
# anything marked required below is missing, rather than booting a half-built
# instance that looks fine until somebody tries to log in.

# --- Where it lives ---------------------------------------------------------
# A bare hostname makes Caddy fetch a certificate for it. Use ":80" to try the
# stack without TLS, or on a host where something else terminates it.
SITE_ADDRESS=eustatement.nl
ACME_EMAIL=you@example.com

# Must match how the browser reaches it, scheme included. Drives CORS, the links
# in emails, the identity provider's callback, and the passkey relying party —
# a passkey enrolled against one hostname is useless at another.
FRONTEND_URL=https://eustatement.nl

# --- Secrets ----------------------------------------------------------------
# openssl rand -hex 32, three times. The two signing secrets must differ; boot
# refuses them equal, and refuses either reused as the encryption key.
JWT_SECRET=
COMPANY_JWT_SECRET=
# Back this up somewhere other than the database dump. It cannot be rotated by
# anything that exists yet: change it and every stored submission becomes
# unreadable.
ENCRYPTION_KEY=

POSTGRES_PASSWORD=

# --- Proxies ----------------------------------------------------------------
# 1 = Caddy only. 2 = Cloudflare in front of Caddy. Too high and
# X-Forwarded-For can be forged, so every IP-keyed limit is evaded; too low and
# every client looks like the proxy and shares one bucket.
TRUST_PROXY_HOPS=1

# --- Second factor ----------------------------------------------------------
# Leave at 0 for the first deploy. Enrol a passkey on your own account and on
# the admin account, save the recovery codes, and only then set this to 1.
REQUIRE_MFA=0

# --- Mail -------------------------------------------------------------------
# No message has ever been delivered from this project. Until these are real,
# every decision, invitation and password reset fails silently.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="eustatement <noreply@eustatement.nl>"
ADMIN_EMAIL=you@example.com

# --- Bot protection ---------------------------------------------------------
# From the Cloudflare dashboard. Without them the anti-robot check is inert and
# the public form can be scripted.
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# --- Identity verification --------------------------------------------------
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=

# Optional. Substance names PubChem does not know (most non-English ones) are
# checked against Wikidata. Wikimedia asks automated clients to say who they
# are; put a URL or address here you are happy to send them. Left empty, the
# lookups still work and identify only as the product.
WIKIDATA_CONTACT=

# Languages the on-server translator loads, comma-separated ISO codes. Each
# costs about 200 MB of memory; the default fits a 4 GB server alongside
# everything else. English must stay in the list — every translation goes
# through it.
TRANSLATE_LANGUAGES=en,nl,de,fr,es,it,pl
