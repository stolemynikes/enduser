# Caddy serves the app, proxies the API, terminates TLS and sets the security
# headers. It replaces nginx here for one reason: the certificate handling is
# automatic, and a renewal nobody has to remember is a renewal that happens.
#
# This file is the production counterpart of public/_headers. That file is
# Netlify and Cloudflare Pages syntax; anything else ignores it, and a header
# policy that is quietly absent is the worst outcome — the page works, so
# nothing complains. Keep the two in step.

{
	# Proxies in front send the real client address in X-Forwarded-For. Caddy
	# only keeps that header from addresses listed here; from anyone else it
	# throws it away and records the connecting address instead. Behind
	# Cloudflare that means listing Cloudflare, or every visitor arrives at the
	# backend as one of a handful of Cloudflare addresses and shares their
	# rate-limit buckets. The ranges are https://www.cloudflare.com/ips — they
	# change rarely, but check them when the Hetzner firewall is updated, since
	# that firewall admits the same list.
	servers {
		trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

# Where the certificate comes from. TLS_MODE picks one of these by name.
#
# origin: the Cloudflare Origin Certificate, mounted from ./certs on the host.
# Cloudflare is the only thing that talks to this server (the Hetzner firewall
# admits nothing else on 80/443), so a certificate only Cloudflare trusts is
# enough, and it lasts fifteen years. Let's Encrypt cannot work in that setup
# anyway: its validation servers are not Cloudflare and never get through.
(tls-origin) {
	tls /certs/origin.pem /certs/origin.key
}
# auto: Caddy fetches and renews a Let's Encrypt certificate itself. For a host
# reached directly, or with SITE_ADDRESS=:80 when testing without TLS.
(tls-auto) {
}

{$SITE_ADDRESS} {
	import tls-{$TLS_MODE:auto}
	encode gzip zstd

	# One address for the app. www works because people type it, but passkeys,
	# sessions in localStorage and the links in emails all belong to one
	# origin, so www is sent to the bare domain rather than served as a twin.
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	# --- The API and the routes the identity provider calls -----------------
	# Same origin as the app on purpose: the browser never makes a
	# cross-origin request, so no CORS preflight and no third-party cookie
	# question arises.
	@api path /graphql /graphql/* /verification-session /verification-status/* /didit-webhook /health
	handle @api {
		reverse_proxy api:3000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# --- Headers on everything ---------------------------------------------
	header {
		# Out of every search index. The header is the half that works: it
		# reaches a crawler that never renders the page, and it travels on a
		# response reached from somebody else's link.
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"

		# Session tokens live in localStorage, so an injected script could read
		# them. Scripts are restricted to this origin, plus Cloudflare's anti-robot
		# check (Turnstile), which loads a script and a frame from
		# challenges.cloudflare.com — without it every form waits for a token
		# that never comes. Nothing may frame the app except the embed route below.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-src https://verify.didit.me https://challenges.cloudflare.com; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"

		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

		# Server software and version is free reconnaissance.
		-Server
	}

	# --- The one route a seller may frame ------------------------------------
	# Sellers embed this on their own website, so it is the single exception to
	# frame-ancestors 'none'. Everything else about the policy is unchanged,
	# including that scripts still come only from here.
	@embed path /embed/*
	header @embed {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-src https://verify.didit.me https://challenges.cloudflare.com; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors https:"
		# Deleted, not blanked. An empty value emits an empty header, and a
		# browser meeting X-Frame-Options with nothing after it may still refuse
		# the frame — which would break the one route that exists to be framed.
		-X-Frame-Options
	}

	# --- Caching -------------------------------------------------------------
	# Vite fingerprints asset filenames, so those may be cached forever. The
	# HTML must not be: it is what points at the current filenames, and a cached
	# copy keeps sending people to assets that no longer exist after a deploy.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@html path / /index.html
	header @html Cache-Control "no-cache"

	# --- Static files and SPA routing ---------------------------------------
	# A second `handle`, rather than leaving file serving at the top level:
	# `handle` blocks are mutually exclusive, so this says plainly that a request
	# is either the API or a file, instead of relying on Caddy's directive order
	# to arrive at the same answer.
	handle {
		root * /srv
		# Every unknown path falls back to index.html, because a company form
		# lives at /{slug} and is routed in the browser. Nothing here is a real
		# directory.
		try_files {path} /index.html
		file_server
	}
}
