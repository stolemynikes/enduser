generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Submission {
  id                  String           @id @default(uuid())
  email               String
  orderNumber         String
  firstName           String
  lastName            String
  street              String
  zipCode             String
  place               String
  country             String
  companyName         String
  vatNumber           String
  buyerType           BuyerType        @default(COMPANY)
  substances          String
  casNumbers          String
  /// Declared strength, e.g. "15% w/w". Free text: the buyer copies what is on
  /// the label. Not PII, so not encrypted — the substance check reads it.
  concentration       String?
  statement           String
  idDocumentName      String?
  idDocumentType      IdDocumentType?
  idDocumentNumber    String?
  idDataCollectedAt   DateTime?
  // Legacy in-house OCR signals. Kept for rows captured before identity
  // verification moved to Didit; never written for new submissions.
  idMrzValid          Boolean?
  idLikelySynthetic   Boolean?
  idDocumentExpiry    DateTime?
  // Didit hosted verification. The session id is a plain opaque UUID (not
  // encrypted) because the webhook has to look the row up by it.
  idVerificationSessionId String?               @unique
  idVerificationStatus    IdVerificationStatus  @default(NOT_CHECKED)
  idLivenessPassed        Boolean?
  idFaceMatch             Boolean?
  idVerificationWarnings  String?
  idVerificationCheckedAt DateTime?
  /// True once the Didit-side session (including the document images) has been purged.
  idVerificationPurged    Boolean               @default(false)
  /// When the nightly reconcile last tried this check. It works through open
  /// checks least-recently-tried first, so ones that never resolve cannot
  /// hold the front of the queue for good.
  idReconciledAt          DateTime?
  /// When this check was reported as stuck, so the admin is told once.
  idStuckReportedAt       DateTime?
  /// Deterministic fingerprints, so equal values can be found without storing a
  /// readable one. Everything above is encrypted with a random IV, which means
  /// the same passport number twice produces two unrelated ciphertexts and no
  /// query can match them. These are HMACs of the normalised value: same input,
  /// same code, and the code cannot be turned back into the value. Used only to
  /// tell a reviewer "this buyer has been here before", never to look anything up
  /// across tenants.
  idDocumentNumberHash String?
  vatNumberHash        String?
  /// Fingerprint of the sorted, normalised CAS set — so the same substances in a
  /// different order still match. Falls back to the substance names when no CAS
  /// number was collected.
  substanceKeyHash     String?
  viesStatus          ViesStatus
  viesName            String?
  viesAddress         String?
  viesAddressMatch    ViesAddressMatch @default(NOT_CHECKED)
  substanceCheckStatus SubstanceCheckStatus @default(NOT_CHECKED)
  substanceCheckNote   String?
  substanceCheckedAt   DateTime?
  /// Language the buyer chose on the form (ISO 639-1). A hint, not a fact: a
  /// buyer can pick Dutch and write in English.
  locale               String?
  /// Language the stated use is actually written in, as detected.
  statementLang        String?
  /// Machine translation of the stated use into English, made on this server
  /// (LibreTranslate). A reading aid for the reviewer; the original in
  /// `statement` is the record. Encrypted like the original.
  statementTranslation String?
  status              SubmissionStatus @default(PENDING_REVIEW)
  adminNote           String?
  reviewedById        String?
  reviewedByName      String?
  reviewedAt          DateTime?
  isTest              Boolean          @default(false)
  company             Company?         @relation(fields: [companyId], references: [id])
  companyId           String?
  overrides           SubmissionOverride[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // Postgres does not index foreign keys automatically and Prisma does not add
  // them for it, so every tenant-scoped query was a sequential scan.
  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([status])
  @@index([idDataCollectedAt])
  // Duplicate lookup is always scoped to one tenant — a match in another
  // seller's queue is none of this seller's business.
  @@index([companyId, idDocumentNumberHash])
  @@index([companyId, vatNumberHash])
  @@index([companyId, substanceKeyHash])
  // A partial index on substanceCheckStatus = 'PENDING' also exists, added by
  // migration 20261005180000. Prisma's schema language cannot express a partial
  // index, so it lives in SQL only — do not "tidy" it away by regenerating.
}

// One row per manual override of a failing automated check (VIES / Identity /
// Substance). Records who bypassed the check, when, and why — the audit trail
// behind a fail-closed approval.
model SubmissionOverride {
  id            String           @id @default(uuid())
  submission    Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId  String
  category      OverrideCategory
  reason        String
  createdById   String
  createdByName String
  createdAt     DateTime         @default(now())

  @@index([submissionId])
}

enum OverrideCategory {
  VIES
  IDENTITY
  SUBSTANCE
}

model Company {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  formConfig  Json?
  createdAt   DateTime        @default(now())
  /// Closure is a 30-day grace period, not an instant wipe: the owner can undo
  /// it, and only the purge at the end is irreversible.
  deletionRequestedAt   DateTime?
  deletionRequestedById String?
  /// Set when the grace period expires and the tenant is purged.
  deletedAt   DateTime?
  /// Access is granted by hand. A new company can sign in and set up, but its
  /// public form stays closed until a platform admin approves it — a form on
  /// this domain collects identity documents, and who gets one is decided
  /// before the first buyer arrives, not after.
  approvedAt      DateTime?
  approvedById    String?
  rejectedAt      DateTime?
  rejectionReason String?
  /// What the applicant said about their business when requesting access.
  requestNote     String?
  members     CompanyMember[]
  notifications Notification[]
  invites     CompanyInvite[]
  submissions Submission[]
}

model CompanyUser {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  name           String
  emailVerifiedAt DateTime?
  /// Tokens issued before this instant are refused. Bumped on password reset,
  /// so a stolen session dies when the owner reacts to the theft.
  sessionsValidFrom DateTime?
  /// Per-account brute-force state. The IP limiter alone cannot see an attack
  /// spread across many addresses.
  failedLogins   Int             @default(0)
  lockedUntil    DateTime?
  /// Second factor. The shared secret is encrypted at rest with the same key
  /// as buyer PII; it is useless to anyone who cannot also present a code, but
  /// a stolen secret is a permanent bypass, so it is never stored in the clear.
  totpSecret        String?
  /// Set the moment a first valid code proved the app was really configured.
  /// Enrolment that never got that far leaves a secret but no second factor.
  totpEnabledAt     DateTime?
  /// Last accepted 30-second step. A code stays valid for the rest of its step,
  /// so without this one read over a shoulder can be replayed for a minute.
  totpLastCounter   Int?
  createdAt      DateTime        @default(now())
  memberships    CompanyMember[]
  authTokens     AuthToken[]
  recoveryCodes  RecoveryCode[]
  passkeys       Passkey[]
}

/// One-time links emailed to a user: password reset and email verification.
/// Only the hash is stored, so a leaked database cannot be used to reset an
/// account — the raw token exists solely in the email.
model AuthToken {
  id        String        @id @default(cuid())
  user      CompanyUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, kind])
  @@index([expiresAt])
}

enum AuthTokenKind {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

/// A Didit session this server started. Was an in-memory Map, which meant a
/// restart stranded every buyer mid-verification (and cost them a second one),
/// and made a second instance impossible.
model VerificationSession {
  sessionId     String               @id
  companyId     String?
  /// Hashed client address. Capacity is budgeted per address and per tenant, so
  /// one caller cannot fill a single global bucket and stop every seller's
  /// identity step.
  ipHash        String?
  status        IdVerificationStatus @default(PENDING)
  lastCheckedAt DateTime?
  consumedAt    DateTime?
  expiresAt     DateTime
  createdAt     DateTime             @default(now())

  @@index([expiresAt])
  @@index([ipHash, expiresAt])
  @@index([companyId, expiresAt])
}

/// Webhook deliveries already processed. Didit retries, so events must be
/// handled at most once — across restarts and across instances.
model WebhookEvent {
  eventId   String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model CompanyMember {
  id        String      @id @default(cuid())
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  user      CompanyUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      CompanyRole @default(EMPLOYEE)
  createdAt DateTime    @default(now())
  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId])
}

model CompanyInvite {
  id        String      @id @default(cuid())
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  email     String
  role      CompanyRole @default(EMPLOYEE)
  /// SHA-256 of a 32-byte random token. The previous cuid() default leaked its
  /// own structure — consecutive invites shared most of their characters — and
  /// the raw value should never be at rest anyway.
  tokenHash String      @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([companyId])
}

enum CompanyRole {
  OWNER
  EMPLOYEE_PLUS
  EMPLOYEE
}

enum IdDocumentType {
  PASSPORT
  ID_CARD
}

// Outcome of the hosted Didit verification. IN_REVIEW means Didit escalated to
// its own manual review; PENDING means the buyer had not finished when the
// submission landed. Neither is green for the approval gate.
enum IdVerificationStatus {
  NOT_CHECKED
  PENDING
  IN_REVIEW
  APPROVED
  DECLINED
  EXPIRED
  ERROR
}

enum BuyerType {
  INDIVIDUAL
  COMPANY
}

enum ViesStatus {
  VALID
  INVALID
  ERROR
  NOT_CHECKED
}

enum ViesAddressMatch {
  NOT_CHECKED
  UNAVAILABLE
  MATCH
  PARTIAL
  MISMATCH
}

enum SubmissionStatus {
  PENDING_REVIEW
  APPROVED
  DENIED
}

enum SubstanceCheckStatus {
  NOT_CHECKED
  PENDING
  OK
  FLAGGED
  ERROR
}

model Admin {
  id       String @id @default(uuid())
  username String @unique
  password String
  sessionsValidFrom DateTime?
  failedLogins Int      @default(0)
  lockedUntil  DateTime?
  /// Second factor. The shared secret is encrypted at rest with the same key
  /// as buyer PII; it is useless to anyone who cannot also present a code, but
  /// a stolen secret is a permanent bypass, so it is never stored in the clear.
  totpSecret        String?
  /// Set the moment a first valid code proved the app was really configured.
  /// Enrolment that never got that far leaves a secret but no second factor.
  totpEnabledAt     DateTime?
  /// Last accepted 30-second step. A code stays valid for the rest of its step,
  /// so without this one read over a shoulder can be replayed for a minute.
  totpLastCounter   Int?
}

/// Single-use codes for the day the authenticator app is on a lost phone.
///
/// Without these, enabling a second factor is a way to lock yourself out
/// permanently — and the only alternative is a support path that can disable
/// someone's MFA, which is itself an attack. Stored as hashes for the same
/// reason passwords are.
model RecoveryCode {
  id        String       @id @default(cuid())
  /// Exactly one of these is set: a seller's account, or a platform admin.
  userId    String?
  adminId   String?
  codeHash  String       @unique
  usedAt    DateTime?
  createdAt DateTime     @default(now())
  user      CompanyUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([adminId, usedAt])
}

/// A passkey: a key pair the browser holds, bound to this origin.
///
/// This is the only second factor that survives the attack a one-time code
/// cannot. A phishing proxy can relay a password and six digits in real time,
/// but it cannot make a passkey sign for a domain it does not own — the browser
/// refuses, whatever the victim types. Which is why it exists alongside TOTP
/// rather than instead of it: TOTP is the fallback for a device that has no
/// authenticator, and the passkey is the one that actually closes the hole.
model Passkey {
  id           String   @id @default(cuid())
  /// Exactly one of these is set: a seller's account, or a platform admin.
  userId       String?
  adminId      String?
  /// The credential id the authenticator reports, base64url. Unique platform-wide.
  credentialId String   @unique
  /// COSE public key, base64url. Public by definition — no secret is stored here,
  /// which is the other reason this beats a shared secret.
  publicKey    String
  /// Signature counter, for authenticators that keep one. A value that fails to
  /// advance can mean a cloned device.
  counter      Int      @default(0)
  /// usb, nfc, ble, internal, hybrid — used to hint the browser's UI.
  transports   String?
  /// What the person called it, so several devices are tellable apart.
  name         String
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?
  user         CompanyUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([adminId])
}

/// One row per time somebody looked at an identity document number.
///
/// The number is the only field on a submission that nobody needs in order to
/// decide anything — Didit has already established who the person is — and the
/// one that turns a leak into identity fraud when combined with the name and
/// address beside it. So it never travels with a query: it comes back from a
/// single mutation that demands a fresh second factor, and writes a line here
/// every time.
///
/// Which also makes bulk extraction countable. Before this, somebody reading
/// four hundred submissions looked exactly like somebody reading one, and there
/// was no way to show afterwards that it had stopped at twelve.
model RevealLog {
  id           String   @id @default(cuid())
  companyId    String
  submissionId String
  /// Who looked. The name is copied in rather than joined, so the record still
  /// reads correctly after the account is renamed or removed.
  userId       String
  userName     String
  /// Session the reveal came from, so two browsers on one account are
  /// distinguishable in the log.
  sessionId    String?
  /// Set when platform staff did this through a support session.
  adminId      String?
  at           DateTime @default(now())

  @@index([companyId, at])
  @@index([submissionId])
}

// Audit trail: one row per admin "act as company" support session.
/// Rate-limit counters. In memory they were per-process — a restart cleared
/// every budget and a second instance doubled them all.
model RateLimitHit {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}

/// Outbound mail budget per recipient, so the public form cannot be turned into
/// a mailer aimed at someone else's inbox.
model MailBudget {
  recipientHash String
  kind          String
  sentAt        DateTime @default(now())
  id            String   @id @default(cuid())

  @@index([recipientHash, kind, sentAt])
  @@index([sentAt])
}

/// What the dashboard's bell shows.
///
/// Email reaches people who may not be able to log in; this reaches people who
/// are already looking. The two carry different things on purpose: anything that
/// matters when you are locked out stays email, and the operational stream —
/// a statement arrived, a check came back bad — lives here, where it used to be
/// nothing at all.
model Notification {
  id        String           @id @default(cuid())
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  /// Null means everyone who can act in this company. Set when the message is
  /// about one person ("your role changed").
  userId    String?
  kind      NotificationKind
  title     String
  body      String?
  /// Where the bell takes you — a submission id, or null for nothing to open.
  submissionId String?
  readAt    DateTime?
  /// Company users who cleared this from their own activity list. Clearing is
  /// per person: a shared notice disappears for the one who cleared it, not
  /// for the rest of the team.
  dismissedBy String[]       @default([])
  createdAt DateTime         @default(now())

  // The panel reads "newest first, unread first" for one tenant.
  @@index([companyId, createdAt])
  @@index([companyId, userId, readAt])
}

enum NotificationKind {
  SUBMISSION_RECEIVED
  SUBSTANCE_FLAGGED
  VIES_INVALID
  IDENTITY_DECLINED
  DOCUMENT_EXPIRING
  DUPLICATE_SEEN
  ROLE_CHANGED
  INVITE_ACCEPTED
  SUPPORT_ACCESS
}

model SupportAccess {
  id        String   @id @default(cuid())
  adminId   String
  companyId String
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

/// How each outside service last answered: PubChem, Wikidata, VIES, Didit, the
/// translator, the mail server. One row per service, updated on every call, so
/// the admin health page can say "VIES unreachable since 14:02" without
/// probing anything itself. Holds no personal data.
model ServiceHealth {
  service    String    @id
  lastOkAt   DateTime?
  lastFailAt DateTime?
  /// Failures in a row since the last success.
  failStreak Int       @default(0)
  updatedAt  DateTime  @updatedAt
}

/// Counted operational events: what happened and when, never to whom. Things
/// that leave no other trace — a Didit session started, a purge given up on,
/// an email that failed to send. Pruned after a year.
model OpsEvent {
  id        String   @id @default(cuid())
  kind      String
  /// A sub-kind where one helps, e.g. which email failed. Never personal data.
  detail    String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

/// A seller acting on a buyer's data-protection request: an access export or
/// an erasure. Who did it, when, and how many statements it covered — never
/// who the buyer was, so the record of an erasure does not undo it. Kept as
/// long as the statements themselves (RETENTION_MONTHS).
model BuyerDataAction {
  id         String         @id @default(cuid())
  companyId  String
  userId     String
  /// Copied in, so the record still reads after the member leaves.
  userName   String
  /// Set when platform support did it inside a support session.
  adminId    String?
  kind       BuyerDataKind
  statements Int
  createdAt  DateTime       @default(now())

  @@index([companyId, createdAt])
}

enum BuyerDataKind {
  EXPORT
  ERASURE
  /// The decision log for a period, for an auditor or an inspection.
  DECISION_EXPORT
}

/// A company owner accepting the Terms, the Data Processing Agreement and the
/// Privacy Policy, at one version (the date on the legal pages). One row per
/// acceptance, so a company's history reads back: accepted on registration,
/// accepted again after each change.
model LegalAcceptance {
  id         String   @id @default(cuid())
  companyId  String
  userId     String
  /// Copied in, so the record still reads after the member leaves.
  userName   String
  userEmail  String
  version    String
  acceptedAt DateTime @default(now())

  @@index([companyId, acceptedAt])
}

/// An announced new or replaced sub-processor. The DPA promises at least 30
/// days' notice, by email and in the dashboard; this is that notice, and the
/// record that it was given.
model SubprocessorNotice {
  id          String   @id @default(cuid())
  name        String
  purpose     String
  data        String
  location    String
  effectiveAt DateTime
  /// Owners the email was sent to, and how many of those sends failed.
  sent        Int      @default(0)
  failed      Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())

  @@index([effectiveAt])
}

/// A message to company owners about a security incident or a personal-data
/// breach. The DPA promises sellers are told without undue delay; this is the
/// telling, and the record of when and to whom (by count).
model IncidentNotice {
  id          String   @id @default(cuid())
  subject     String
  message     String
  /// Companies addressed: every company on the platform, or the listed ones.
  allCompanies Boolean
  companies   Int
  sent        Int      @default(0)
  failed      Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
}
